#!/usr/bin/env bash
set -Eeuo pipefail

DOCKER_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$DOCKER_DIR/.." && pwd)"
GAME_NAME="${1:-tribes2}"
GAMES_DIR="$REPO_DIR/games"
GAME_SOURCE="$REPO_DIR/games/$GAME_NAME"
hook_container=""

if [[ -e "$DOCKER_DIR/build" ]]; then
    echo "Build staging directory already exists: $DOCKER_DIR/build" >&2
    exit 2
fi

for required in \
    "$DOCKER_DIR/compat-libs/libstdc++-libc6.2-2.so.3" \
    "$DOCKER_DIR/compat-libs/libSDL-1.2.so.0" \
    "$DOCKER_DIR/compat-libs/libsmpeg-0.4.so.0"; do
    if [[ ! -f "$required" ]]; then
        echo "Required legacy runtime library is missing: $required" >&2
        exit 2
    fi
done

cleanup() {
    if [[ -n "$hook_container" ]]; then docker rm "$hook_container" >/dev/null 2>&1 || true; fi
    rm -rf "$DOCKER_DIR/build"
}
trap cleanup EXIT

if [[ -d "$GAME_SOURCE" ]]; then
    mkdir -p "$DOCKER_DIR/build"
    cp -a "$GAME_SOURCE"/. "$DOCKER_DIR/build"/
else
    echo "No bundled game files at $GAME_SOURCE; image will use a runtime game-folder mount."
    mkdir -p "$DOCKER_DIR/build"
fi
cp "$REPO_DIR/t2_hook.c" "$DOCKER_DIR/build/t2_hook.c"

USER_UID="${SUDO_UID:-$(id -u)}"
USER_GID="${SUDO_GID:-$(id -g)}"
docker build \
    --build-arg USER_UID="$USER_UID" \
    --build-arg USER_GID="$USER_GID" \
    -t "$GAME_NAME" "$DOCKER_DIR"

if [[ "$GAME_NAME" == "tribes2" && -d "$GAMES_DIR/$GAME_NAME" ]]; then
    hook_container="$(docker create "$GAME_NAME")"
    docker cp "$hook_container:/home/loki/game/t2_hook.so" "$GAMES_DIR/$GAME_NAME/t2_hook.so"
    docker rm "$hook_container" >/dev/null
    hook_container=""
fi
